    {
      "name": "08 - Rate Limiting (MANUAL)",
      "description": "Do not run this folder as a normal collection run. The authentication limiter is 10 requests per 15 minutes and the booking limiter is 30 requests per 15 minutes. Send the relevant request repeatedly until HTTP 429 appears, then capture the response as evidence.",
      "item": [
        {
          "name": "Auth Rate Limit - Send Repeatedly",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Send this same request repeatedly. After the configured limit is reached, expected status is 429 Too Many Requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rate-limit-test@example.com\",\n  \"password\": \"WrongPass123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Rate-limit evidence request\", function () {",
                  "    pm.expect([401, 429]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Booking Rate Limit - Send Repeatedly",
