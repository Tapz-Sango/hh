    {
      "name": "05 - Input Sanitisation",
      "item": [
        {
          "name": "Malicious HTML Is Sanitised",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/services",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{freelancerAToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"<script>alert('XSS')</script>Safe Title\",\n  \"description\": \"<img src=x onerror=alert('XSS')>Safe description\",\n  \"price\": 300,\n  \"category\": \"Development\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Sanitisation request succeeds - HTTP 200 or 201\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "var text = pm.response.text();",
                  "pm.test(\"Response does not contain script tags\", function () {",
                  "    pm.expect(text.toLowerCase()).to.not.include(\"<script\");",
                  "});",
                  "pm.test(\"Response does not contain onerror attribute\", function () {",
                  "    pm.expect(text.toLowerCase()).to.not.include(\"onerror=\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
