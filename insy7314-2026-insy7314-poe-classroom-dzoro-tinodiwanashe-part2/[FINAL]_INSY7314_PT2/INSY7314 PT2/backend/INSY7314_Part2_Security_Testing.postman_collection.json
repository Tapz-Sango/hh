  "item": [
    {
      "name": "01 - Security Headers",
      "item": [
        {
          "name": "Health Check + Security Headers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/health",
            "description": "Evidence for bullet 7: security headers and CSP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health check returns 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Security-Policy header exists\", function () {",
                  "    pm.expect(pm.response.headers.has(\"Content-Security-Policy\")).to.be.true;",
                  "});",
                  "pm.test(\"X-Content-Type-Options header exists\", function () {",
                  "    pm.expect(pm.response.headers.has(\"X-Content-Type-Options\")).to.be.true;",
                  "});",
                  "pm.test(\"X-Frame-Options header exists\", function () {",
                  "    pm.expect(pm.response.headers.has(\"X-Frame-Options\")).to.be.true;",
                  "});",
                  "pm.test(\"Strict-Transport-Security header exists\", function () {",
                  "    pm.expect(pm.response.headers.has(\"Strict-Transport-Security\")).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Authentication / JWT",
      "item": [
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Client\",\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{clientPassword}}\",\n  \"role\": \"client\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var email = 'client_' + Date.now() + '@example.com';",
                  "pm.collectionVariables.set(\"clientEmail\", email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Client registration returns 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var res = pm.response.json();",
                  "console.log('Register Client response:', JSON.stringify(res));",
                  "var token = res.token || res.accessToken || (res.data && (res.data.token || res.data.accessToken));",
