    {
      "name": "07 - Complete Booking & Transaction Flow",
      "description": "End-to-end business flow required for Part 2 demonstration: create service, book it, record simulated transaction, complete booking, verify earnings, and remove the test service.",
      "item": [
        {
          "name": "Get Service By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/services/{{serviceId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Service lookup returns 200\", function () { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "var service = res.data || res.service || res;",
                  "pm.test(\"Returned service matches the created service\", function () {",
                  "    pm.expect(String(service._id || service.id)).to.eql(String(pm.collectionVariables.get(\"serviceId\")));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Freelancer A Updates Own Service",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/services/{{serviceId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{freelancerAToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Service Updated\",\n  \"description\": \"Updated service used for the complete HustleHub workflow test\",\n  \"price\": 275,\n  \"category\": \"Development\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Owner can update own service\", function () { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "var service = res.data || res.service || res;",
                  "pm.test(\"Updated service title is returned\", function () {",
                  "    pm.expect(service.title).to.eql(\"Postman Test Service Updated\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Client Creates Booking + Transaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{clientToken}}", "type": "string" }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"date\": \"{{bookingDate}}\",\n  \"time\": \"{{bookingTime}}\",\n  \"notes\": \"Newman end-to-end booking test\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = new Date();",
                  "d.setDate(d.getDate() + 2);",
                  "var dateStr = d.toISOString().slice(0, 10);",
                  "pm.collectionVariables.set(\"bookingDate\", dateStr);",
                  "pm.collectionVariables.set(\"bookingTime\", \"10:30\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Booking creation returns 201\", function () { pm.response.to.have.status(201); });",
                  "var res = pm.response.json();",
                  "console.log('Create Booking response:', JSON.stringify(res));",
                  "pm.test(\"Booking and transaction are returned\", function () {",
                  "    pm.expect(res.booking).to.exist;",
                  "    pm.expect(res.transaction).to.exist;",
                  "});",
                  "pm.test(\"Transaction has a simulated payment reference\", function () {",
                  "    pm.expect(res.transaction.paymentReference).to.match(/^SIM-/);",
                  "    pm.expect(res.transaction.status).to.eql(\"pending\");",
                  "});",
                  "var bid = res.booking && (res.booking._id || res.booking.id);",
                  "if (bid) { pm.collectionVariables.set(\"bookingId\", bid); }",
                  "pm.collectionVariables.set(\"bookingAmount\", String(res.transaction.amount));"
                ]
              }
            }
          ]
        },
        {
          "name": "Client Views My Bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/bookings/my-bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{clientToken}}", "type": "string" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Client can view bookings\", function () { pm.response.to.have.status(200); });",
                  "var res = pm.response.json();",
                  "pm.test(\"Created booking appears in client bookings\", function () {",
                  "    var bid = pm.collectionVariables.get(\"bookingId\");",
                  "    var found = (res.bookings || []).some(function (b) { return String(b._id || b.id) === String(bid); });",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Freelancer Views Received Booking",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/earnings/bookings",
            "auth": {
              "type": "bearer",
